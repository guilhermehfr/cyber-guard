NEXT_PUBLIC_API_URL=http://localhost:3000
API_URL=http://api:3000
# Absolute API URL for the realtime WebSocket. Only needed when
# NEXT_PUBLIC_API_URL is a relative path (the API is proxied under /api),
# because rewrites do not forward WebSocket upgrades.
# NEXT_PUBLIC_WS_URL=http://localhost:3000
# Dev-only bypass for /play authentication; inert in production builds
NEXT_PUBLIC_AUTH_BYPASS=false
