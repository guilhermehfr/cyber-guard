# Runtime environment and HTTP port
NODE_ENV=development
PORT=3000

# Comma-separated list of allowed frontend origins (development)
WEB_URL=http://localhost:3001,http://localhost:3002

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cyberguard

# Redis connection and default gameplay-session TTL in seconds
REDIS_URL=redis://localhost:6379
REDIS_TTL_SECONDS=600

# JWT signing secret (min 32 characters) and expiration
JWT_SECRET=
JWT_EXPIRES_IN=1d

# Auth cookies (development defaults)
# Production uses AUTH_COOKIE_SECURE=true and AUTH_COOKIE_SAMESITE=none
AUTH_COOKIE_NAME=cyberguard.session
AUTH_COOKIE_MARKER_NAME=cyberguard.auth
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax

# Google OAuth client credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback
