  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -w -p tsconfig.json",
    "start": "node dist/main.js",
    "lint": "biome check src",
    "lint:fix": "biome check --write src",
