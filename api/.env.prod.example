# Runtime environment and HTTP port
NODE_ENV=production
PORT=3000

# Comma-separated list of allowed frontend origins (production)
WEB_URL=

# PostgreSQL connection string
DATABASE_URL=

# Redis connection URL
REDIS_URL=

# JWT signing secret (min 32 characters) and expiration
JWT_SECRET=
JWT_EXPIRES_IN=1d

# Auth cookies (production defaults)
# Cross-domain cookies require Secure=true and SameSite=None
AUTH_COOKIE_NAME=cyberguard.session
AUTH_COOKIE_MARKER_NAME=cyberguard.auth
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=none

# Google OAuth client credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=
